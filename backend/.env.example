# 复制为 backend/.env 后按需填写。密钥仅存本机，勿提交仓库。

# ---------- 服务 ----------
HERMES_HOST=127.0.0.1
HERMES_PORT=8765
HERMES_STORAGE_DIR=storage
HERMES_DB_URL=sqlite:///storage/hermes.db

# ---------- 对话 / 文本 LLM ----------
# mock | openai | minimax（OpenAI 兼容 Chat Completions）
# Ollama 本地：BASE_URL=http://127.0.0.1:11434/v1 ，勿填 /api/chat（会 404；程序会尽量把 /api/chat 纠成 /v1）
HERMES_LLM_PROVIDER=mock
HERMES_LLM_BASE_URL=https://api.openai.com/v1
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=gpt-4o

# ---------- 多模态 VLM（镜头理解、配图 API 等）----------
# mock | openai | minimax | gemma4（自定义标签，仍走 OpenAI 兼容 base）。BASE_URL / API_KEY 留空则沿用 HERMES_LLM_*
HERMES_VLM_PROVIDER=mock
HERMES_VLM_BASE_URL=
HERMES_VLM_API_KEY=
HERMES_VLM_MODEL=gpt-4o

# ---------- 生图 ----------
# mock | openai | replicate | minimax。BASE_URL / API_KEY 留空则沿用 HERMES_LLM_*
# MiniMax 图生图：BASE_URL=https://api.minimaxi.com ，MODEL=image-01 或 image-01-live（见官方文档 /v1/image_generation）
HERMES_IMAGE_PROVIDER=mock
HERMES_IMAGE_BASE_URL=
HERMES_IMAGE_API_KEY=
HERMES_IMAGE_MODEL=dall-e-3

# ---------- 生视频 ----------
# mock | minimax | runway | luma | replicate
# MiniMax（官方异步）：HERMES_VIDEO_PROVIDER=minimax
#   HERMES_VIDEO_BASE_URL=https://api.minimaxi.com  HERMES_VIDEO_API_KEY=<MINIMAX_API_KEY>
#   文生（仅 prompt）：MiniMax-Hailuo-2.3 / MiniMax-Hailuo-02 / T2V-01*（不可用 *-Fast，Fast 仅图生）
#   图生（有首帧）：可加 MiniMax-Hailuo-2.3-Fast；控制台简称 Hailuo-2.3-Fast 程序会映射为 MiniMax-* 
#   主体参考：S2V-01 等（需参照图）
#   流程：POST /v1/video_generation → 轮询 /v1/query/video_generation → GET /v1/files/retrieve 下载
# HERMES_VIDEO_MINIMAX_POLL_INTERVAL=10
# Token 套餐请用 768P；1080P 需更高档位
# HERMES_VIDEO_MINIMAX_RESOLUTION=768P
# 为 true（默认）时：MiniMax 出片须带角色库参照图，禁止无参考「凭空」文生；脚本 smoke 会自行关闭
# HERMES_VIDEO_REQUIRE_CHARACTER_REFERENCE=true
# 若 PROVIDER=mock 但已填写 api.minimaxi.com 与有效 KEY，后端会自动按 minimax 出片；仍建议显式设为 minimax
HERMES_VIDEO_PROVIDER=mock
HERMES_VIDEO_BASE_URL=
HERMES_VIDEO_API_KEY=
HERMES_VIDEO_MODEL=MiniMax-Hailuo-2.3
# 主模型创建失败时重试；Hailuo-2.3-Fast-768P = Fast + 768P。设为空可关闭
# HERMES_VIDEO_MODEL_FALLBACK=Hailuo-2.3-Fast-768P

# ---------- 配音 TTS ----------
# mock | openai | elevenlabs | minimax
# MiniMax：优先 POST /v1/t2a_v2（官方同步语音）；失败再回退 OpenAI 兼容 /v1/audio/speech
HERMES_TTS_PROVIDER=mock
# MiniMax 配音：BASE 一般为 https://api.minimaxi.com ，密钥与平台控制台一致
HERMES_TTS_BASE_URL=
HERMES_TTS_API_KEY=
# 兼容网关时用 tts-1；官方 T2A 会用 speech-*（见 HERMES_MINIMAX_VOICE_CLONE_MODEL）
HERMES_TTS_MODEL=tts-1
# MiniMax T2A / voice_clone 使用的 speech 模型（如 speech-2.8-hd）
# HERMES_MINIMAX_VOICE_CLONE_MODEL=speech-2.8-hd
# 当角色音色仍为 alloy / mock-voice-1 等占位时，T2A 使用的默认平台音色 id
# HERMES_TTS_MINIMAX_DEFAULT_VOICE_ID=male-qn-qingse

# 叙事干预生成镜头：若有台词，会 TTS 并与下方 BGM 混音后再压入成片（相对 HERMES_STORAGE_DIR，或填绝对路径）
# 例：generated/_smoke_bgm_download.mp3
# HERMES_GENERATION_BGM_PATH=
# HERMES_GENERATION_BGM_VOICE_GAIN=1.35
# HERMES_GENERATION_BGM_TRACK_GAIN=0.14

# ---------- 镜头音轨 ASR（对白转写，OpenAI 兼容 POST /v1/audio/transcriptions）----------
# mock=不调用。BASE_URL 留空则沿用 HERMES_LLM_*；若 LLM 为 api.minimaxi.com 且未单独写 ASR 地址，程序会跳过转写（MiniMax 无此 OpenAI 路径）
HERMES_ASR_PROVIDER=mock
# 需要转写时建议填 OpenAI 或本地 Whisper 兼容网关，勿沿用 MiniMax 域名
HERMES_ASR_BASE_URL=
HERMES_ASR_API_KEY=
HERMES_ASR_MODEL=whisper-1
# ISO-639-1，如 zh、en；留空则让服务端自判
HERMES_ASR_LANGUAGE=

# ---------- 叙事干预（分支）----------
# 为 true：禁用分镜兜底链与视频占位片；分镜须 LLM 直接产出，视频须 MiniMax 等真实成功（勿用于本地 smoke）
# HERMES_INTERVENTION_NO_FALLBACK=false

# ---------- 其它 ----------
HERMES_DEFAULT_PROFILE=fast
# 为 true 时合并 SQLite「模型配置」表（设置页）；默认 false，仅用本文件中 HERMES_*，避免库里曾保存的地址覆盖 .env
# HERMES_USE_SQLITE_MODEL_CONFIGS=false
