# 服务监听
HERMES_HOST=0.0.0.0
HERMES_PORT=8765

# 存储目录（默认相对 backend/）
HERMES_STORAGE_DIR=storage
HERMES_DB_URL=sqlite:///storage/hermes.db

# ---------- 对话 / 文本 LLM ----------
# mock | openai | minimax（OpenAI 兼容）
HERMES_LLM_PROVIDER=minimax
HERMES_LLM_BASE_URL=https://api.minimaxi.com/v1
HERMES_LLM_API_KEY=sk-cp-WkdJ3otRRxeg552AHOCJAIh3UURYPUOC4IepBnYdHLKjOqihNYBIKTzkH0gXiyCpM-QrUr-BMpDmOBm07DXkzIev9G6rqOV4Wm7y0OTN7-pheVnMV4QXsJ0
HERMES_LLM_MODEL=MiniMax-M2.7

# ---------- 多模态 VLM（镜头理解等）----------
# 可与 LLM 不同厂商；BASE_URL / API_KEY 留空则沿用上方 HERMES_LLM_*
HERMES_VLM_PROVIDER=minimax
HERMES_VLM_BASE_URL=https://api.minimaxi.com/v1
HERMES_VLM_API_KEY=sk-cp-WkdJ3otRRxeg552AHOCJAIh3UURYPUOC4IepBnYdHLKjOqihNYBIKTzkH0gXiyCpM-QrUr-BMpDmOBm07DXkzIev9G6rqOV4Wm7y0OTN7-pheVnMV4QXsJ0
HERMES_VLM_MODEL=MiniMax-M2.7

# ---------- 生图 ----------
HERMES_IMAGE_PROVIDER=minimax
HERMES_IMAGE_BASE_URL=https://api.minimaxi.com/v1
HERMES_IMAGE_API_KEY=sk-cp-WkdJ3otRRxeg552AHOCJAIh3UURYPUOC4IepBnYdHLKjOqihNYBIKTzkH0gXiyCpM-QrUr-BMpDmOBm07DXkzIev9G6rqOV4Wm7y0OTN7-pheVnMV4QXsJ0
HERMES_IMAGE_MODEL=image-01

# ---------- 生视频 ----------
HERMES_VIDEO_PROVIDER=minimax
HERMES_VIDEO_BASE_URL=https://api.minimaxi.com/v1
HERMES_VIDEO_API_KEY=sk-cp-WkdJ3otRRxeg552AHOCJAIh3UURYPUOC4IepBnYdHLKjOqihNYBIKTzkH0gXiyCpM-QrUr-BMpDmOBm07DXkzIev9G6rqOV4Wm7y0OTN7-pheVnMV4QXsJ0
HERMES_VIDEO_MODEL=Hailuo-2.3-Fast

# ---------- 配音 TTS ----------
HERMES_TTS_PROVIDER=minimax
HERMES_TTS_BASE_URL=https://api.minimaxi.com/v1
HERMES_TTS_API_KEY=sk-cp-WkdJ3otRRxeg552AHOCJAIh3UURYPUOC4IepBnYdHLKjOqihNYBIKTzkH0gXiyCpM-QrUr-BMpDmOBm07DXkzIev9G6rqOV4Wm7y0OTN7-pheVnMV4QXsJ0
HERMES_TTS_MODEL=speech-2.8-hd

# 演示模式：fast | quality | fallback
HERMES_DEFAULT_PROFILE=fast

HERMES_ASR_PROVIDER=minimax
HERMES_ASR_BASE_URL=https://api.minimaxi.com/v1
HERMES_ASR_API_KEY=sk-cp-WkdJ3otRRxeg552AHOCJAIh3UURYPUOC4IepBnYdHLKjOqihNYBIKTzkH0gXiyCpM-QrUr-BMpDmOBm07DXkzIev9G6rqOV4Wm7y0OTN7-pheVnMV4QXsJ0
HERMES_ASR_MODEL=speech-2.8-hd
# ISO-639-1，如 zh、en；留空则让服务端自判
HERMES_ASR_LANGUAGE=zh-CN